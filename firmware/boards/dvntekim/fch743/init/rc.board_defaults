#!/bin/sh
#
# dvntekim fch743 board defaults
#------------------------------------------------------------------------------

# Generic quad X until the airframe is tuned
param set-default SYS_AUTOSTART 4001

# VBAT divider 100k/10k; ESC current scale must be set for the ESC in use
param set-default BAT1_V_DIV 11.0
param set-default BAT1_A_PER_V 40.0

# GPS-denied indoor platform: no magnetometer on board
param set-default SYS_HAS_MAG 0

# IMU heater (PB9) holds the IMUs at 45 C
param set-default SENS_EN_THERMAL 1
param set-default HEATER1_TEMP 45

# TELEM2: companion computer via uXRCE-DDS
param set-default UXRCE_DDS_CFG 102

# Bidirectional DShot600 on M1-M4 (TIM1)
param set-default PWM_MAIN_TIM0 -6

# ESC serial telemetry on UART8 (listed as GPS2 in PX4's port names)
param set-default DSHOT_TEL_CFG 202
